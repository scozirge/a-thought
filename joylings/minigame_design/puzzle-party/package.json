{
  "name": "puzzle-party",
  "version": "0.12.0",
  "private": true,
  "description": "一起想想：國小二、三年級的四組合作解謎，Unity WebGL 單機與跨網連線",
  "scripts": {
    "build": "powershell -ExecutionPolicy Bypass -File tools/build-unity.ps1",
    "build:unity": "powershell -ExecutionPolicy Bypass -File tools/build-unity.ps1",
    "start:unity": "node tools/serve.cjs 8190 --unity",
    "start": "node tools/serve.cjs",
    "test": "node --test tests/rules.test.cjs",
    "test:online": "node tests/online-browser.cjs",
    "test:rooms": "node tests/room-browser.cjs",
    "test:resilience": "node tests/online-resilience.cjs",
    "test:published": "node tests/published-browser.cjs",
    "analyze": "node tools/analyze.cjs",
    "package:unity": "powershell -ExecutionPolicy Bypass -File tools/package-unity.ps1"
  }
}
