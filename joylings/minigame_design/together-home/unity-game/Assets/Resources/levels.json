:[{"x":80,"y":285,"text":"① 接力冰橋 →"},{"x":1070,"y":180,"text":"② 重量換高度 →"},{"x":1770,"y":110,"text":"③ 輪流接朋友 ↑"},{"x":2510,"y":-440,"text":"④ 日月登頂 ↗"},{"x":3060,"y":-730,"text":"⑤ 最後接力 →"}],"ascent":true,"roof":true,"id":18,"group":"main"},{"viewHeight":480,"platforms":[{"x":1740,"y":350,"w":50,"h":12},{"x":1966,"y":350,"w":50,"h":12},{"x":2376,"y":350,"w":50,"h":12},{"x":2506,"y":350,"w":50,"h":12},{"x":3056,"y":350,"w":50,"h":12},{"x":3166,"y":350,"w":50,"h":12},{"x":3780,"y":240,"w":380,"h":16},{"x":3900,"y":188,"w":80,"h":16},{"x":4320,"y":80,"w":520,"h":16}],"gates":[{"x":400,"y":40,"w":28,"h":360,"buttons":[{"x":1340,"y":400,"w":58,"owner":1}],"openAfterKey":1},{"x":650,"y":40,"w":28,"h":360,"keyIndices":[0,1]},{"x":900,"y":40,"w":28,"h":360,"buttons":[{"x":500,"y":400,"w":58,"owner":0}],"openAfterKey":0},{"x":3280,"y":40,"w":28,"h":360,"buttons":[{"x":2445,"y":400,"w":50,"crateOnly":true},{"x":3130,"y":400,"w":50,"crateOnly":true}],"openAfterKey":4},{"x":4640,"y":-200,"w":28,"h":280,"mode":1,"buttons":[{"x":4540,"y":80,"w":60,"crateOnly":true}]}],"boxes":[{"x":260,"w":48,"h":42,"y":358},{"x":960,"w":48,"h":42,"y":358},{"x":1820,"w":48,"h":42,"y":358},{"x":1930,"w":48,"h":42,"y":358}],"lifts":[{"x":3620,"w":160,"bottom":400,"top":240,"speed":110,"buttons":[{"x":3500,"y":400,"w":58,"owner":1},{"x":3820,"y":240,"w":58,"owner":0}]},{"x":4160,"w":160,"bottom":240,"top":80,"speed":110,"buttons":[{"x":4040,"y":240,"w":58,"owner":0},{"x":4360,"y":80,"w":58,"owner":1}]}],"switches":[{"x":3920,"y":188,"w":42}],"name":"連動貨運總站","hint":"連動開路、渡船送貨，最後接回兩個朋友。","starts":[80,1080],"world":{"width":4840,"top":-180,"bottom":520},"floor":[{"x":0,"y":400,"w":2010},{"x":2370,"y":400,"w":190},{"x":3040,"y":400,"w":580}],"linkedBoxes":[[0,1]],"keys":[{"x":120,"y":270,"r":12,"owner":0},{"x":1200,"y":270,"r":12,"owner":1},{"x":2472,"y":350,"r":12,"owner":1},{"x":3235,"y":350,"r":12,"owner":0},{"x":3360,"y":350,"r":12},{"x":4700,"y":30,"r":12,"owner":1}],"door":{"x":4740,"y":-2,"w":68,"h":82},"solution":["先拿左邊的貓咪鑰匙，再把連動箱子移到右邊拿狗狗鑰匙。箱子遇到牆或人，兩個都會停。","狗狗先走到最右的狗狗按鈕，打開貓咪面前的門。","貓咪穿門踩住貓咪按鈕，打開狗狗房間中間的門。狗狗走到箱子右邊，往左推，讓左邊的箱子移到貓咪鑰匙下。","貓咪繼續踩著，等狗狗回到最右按鈕，再回左邊爬箱子拿鑰匙；狗狗房間的門會固定打開。","狗狗留在最右按鈕。貓咪把左箱往右推到門後，右箱就會移到狗狗鑰匙下。","狗狗爬上右箱拿鑰匙，地面三道門都開了。兩人到右邊碼頭會合；碼頭還有兩個普通貨箱與兩艘渡船，連動箱子留在原區即可。","兩個箱子都要搭船：中間島和右岸各留一個。跳上箭頭台開船，離開箭頭台就停。","狗狗把前面的箱子推上第一艘船，貓咪踩左岸的右箭頭送他過河。","狗狗先把這個箱子一路推上第二艘船，拿自己的鑰匙，再踩中間島左箭頭，把船叫回來。","貓咪把另一個箱子推上第一艘船，狗狗換踩右箭頭接貓咪。貓咪把箱子留在中間島的方形座上。","狗狗踩左箭頭，叫回載著第一個箱子的第二艘船。貓咪跳過中間箱子上船，狗狗再踩右箭頭送她到右岸。","貓咪把箱子留在右岸方形座、拿鑰匙。用右岸左箭頭叫船接狗狗，等狗狗上船再換右箭頭。","過河後，拿門後的鑰匙固定開門。右岸的箱子還有工作，要帶它搭兩次升降台。","把右岸箱子推上第一部升降台，貓咪一起搭，狗狗踩地面狗臉機關送貨上樓。貓咪把箱子推到上層，先等升降台降下，再踩貓臉機關接狗狗。","在中層跳上星星台，把最後的門切成月亮。狗狗把箱子推上第二部升降台，貓咪在下方貓臉機關送他和箱子上頂樓。","狗狗把箱子推到頂樓方形座上，再離開頂樓機關，讓升降台降下來接貓咪。貓咪上台後，狗狗踩頂樓狗臉機關接朋友。","箱子壓住頂樓機關、世界是月亮，最後的門才開。狗狗拿最右邊鑰匙，兩人都到小屋。"],"puzzle":"freight-final","saveKey":"campaign-freight-final-1","fallY":650,"mode":0,"rafts":[{"x":2010,"y":400,"w":150,"h":18,"min":2010,"max":2220,"speed":140,"controls":[{"x":1744,"y":350,"w":42,"dir":-1},{"x":1970,"y":350,"w":36,"dir":1},{"x":2380,"y":350,"w":42,"dir":-1},{"x":2510,"y":350,"w":42,"dir":1}]},{"x":2560,"y":400,"w":150,"h":18,"min":2560,"max":2890,"speed":140,"controls":[{"x":2380,"y":350,"w":42,"dir":-1},{"x":2510,"y":350,"w":42,"dir":1},{"x":3060,"y":350,"w":42,"dir":-1},{"x":3170,"y":350,"w":42,"dir":1}]}],"cargoBox":3,"ferryOffset":1720,"id":19,"group":"main"}]