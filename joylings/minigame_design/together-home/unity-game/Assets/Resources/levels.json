:0,"starts":[80,20],"floor":[{"x":0,"y":400,"w":220},{"x":440,"y":400,"w":160},{"x":820,"y":400,"w":180}],"movers":[],"keys":[{"x":520,"y":378,"r":12,"owner":0},{"x":920,"y":378,"r":12,"owner":1}],"door":{"x":930,"y":318,"w":68,"h":82},"fallY":470,"hint":"一人踩住同號機關接橋，過去的人接手，才能繼續。","solution":["狗狗踩住起點的 1 號機關，貓咪先過左橋，落到中間岸後踩住貓臉 1 號機關。","對岸有人接手後，狗狗才能離開起點；讓狗狗也走過左橋，到中間岸。","貓咪移到中間岸的 2 號機關，這次換狗狗先過右橋，落到右岸後踩住狗臉 2 號機關。","同號兩個機關任一個壓住，橋和門才會開。朋友還在橋上時不要離開機關。","狗狗接手右岸機關後，貓咪才能跟過去。貓咪拿中間的鑰匙，狗狗拿右岸的鑰匙，再一起進小屋。"],"name":"隔岸接橋","preview":"bridge"},{"id":2,"saveKey":"preview-phase-1","group":"main","cameraTop":-60,"boxes":[],"gates":[],"lifts":[],"platforms":[{"x":240,"y":344,"w":140,"h":16,"mode":1},{"x":380,"y":288,"w":140,"h":16},{"x":520,"y":232,"w":140,"h":16,"mode":0},{"x":660,"y":176,"w":140,"h":16},{"x":800,"y":120,"w":100,"h":16,"mode":1},{"x":900,"y":120,"w":100,"h":16}],"switches":[],"name":"跳一下，路就換","preview":"phase","phaseOnJump":true,"mode":0,"hint":"有人起跳，日月踏板就交換；先讓朋友站上木台。","starts":[80,150],"keys":[{"x":450,"y":258,"r":12,"owner":0},{"x":740,"y":146,"r":12,"owner":1}],"door":{"x":930,"y":38,"w":68,"h":82},"solution":["貓咪先跳上第一塊月亮踏板，再跳到旁邊木台。木台不會消失，站穩後才換狗狗上來。","狗狗也用兩次跳躍上同一個木台；貓咪順路拿貓臉鑰匙。","下一塊是太陽踏板。先讓一人在木台原地跳一下，把世界切成月亮，再由另一人起跳切回太陽，跳上太陽踏板。","先上去的人繼續跳到下一個木台站穩，後面的人再跟上。狗狗拿這層的狗臉鑰匙。","最後一塊是月亮踏板。在木台原地跳到太陽亮起，再起跳讓月亮踏板出現。一次一人過去，到了小屋旁的木台再換朋友跟上。"]},{"boxes":[],"gates":[],"lifts":[],"platforms":[{"x":70,"y":344,"w":90,"h":16},{"x":150,"y":288,"w":90,"h":16},{"x":210,"y":240,"w":50,"h":16},{"x":640,"y":240,"w":360,"h":16}],"switches":[],"name":"重量蹺蹺板","preview":"balance","trial":true,"coop":"balance","saveKey":"trial-balance-1","cameraTop":30,"starts":[60,120],"floor":[{"x":0,"y":400,"w":620}],"fallY":470,"balances":[{"a":{"x":280,"w":140},"b":{"x":460,"w":140},"top":240,"bottom":400,"initial":[240,400],"speed":130,"lockKey":0}],"keys":[{"x":700,"y":218,"r":12,"owner":0},{"x":880,"y":218,"r":12,"owner":1}],"door":{"x":930,"y":158,"w":68,"h":82},"hint":"一人壓高板，朋友在低板跳起，借重量升上樓。","solution":["貓咪先走到右