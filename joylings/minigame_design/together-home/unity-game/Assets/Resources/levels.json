:[{"x":660,"y":350,"w":42,"dir":-1},{"x":790,"y":350,"w":42,"dir":1},{"x":1340,"y":350,"w":42,"dir":-1},{"x":1450,"y":350,"w":42,"dir":1}]}],"keys":[{"x":752,"y":350,"r":12,"owner":1},{"x":1515,"y":350,"r":12,"owner":0}],"door":{"x":1630,"y":318,"w":68,"h":82},"solution":["兩個箱子都要搭船：中間島和右岸各留一個。跳上箭頭台開船，離開箭頭台就停。","狗狗把前面的箱子推上第一艘船，貓咪踩左岸的右箭頭送他過河。","狗狗先把這個箱子一路推上第二艘船，拿自己的鑰匙，再踩中間島左箭頭，把船叫回來。","貓咪把另一個箱子推上第一艘船，狗狗換踩右箭頭接貓咪。貓咪把箱子留在中間島的方形座上。","狗狗踩左箭頭，叫回載著第一個箱子的第二艘船。貓咪跳過中間箱子上船，狗狗再踩右箭頭送她到右岸。","貓咪把箱子留在右岸方形座、拿鑰匙。用右岸左箭頭叫船接狗狗，等狗狗上船再換右箭頭。","兩個箱子都留好，兩人通過門，走到小屋。"],"puzzle":"ferry","saveKey":"campaign-ferry-1","id":8,"group":"main"},{"id":9,"cameraTop":-100,"boxes":[{"x":200,"y":358,"w":48,"h":42,"heavy":false}],"gates":[{"x":910,"y":-120,"w":20,"h":520,"buttons":[{"x":860,"y":80,"w":48}]}],"lifts":[{"x":260,"w":140,"bottom":400,"top":240,"speed":90,"buttons":[{"x":120,"y":400,"w":58},{"x":410,"y":240,"w":36}]},{"x":630,"w":150,"bottom":240,"top":80,"speed":90,"buttons":[{"x":450,"y":240,"w":26},{"x":810,"y":80,"w":26}]}],"platforms":[{"x":400,"y":240,"w":230,"h":16},{"x":780,"y":80,"w":220,"h":16}],"switches":[],"name":"送貨到頂樓","hint":"同一個箱子，要轉搭兩部電梯。","starts":[40,90],"keys":[{"x":570,"y":182,"r":12,"owner":1},{"x":950,"y":22,"r":12,"owner":0}],"door":{"x":960,"y":-2,"w":40,"h":82},"solution":["貓咪把箱子推上左邊電梯，狗狗踩地面按鈕送上樓。貓咪把箱子暫停在中間平台中央，別壓住橘色按鈕。","先讓左邊電梯下降接狗狗，再由貓咪踩中間平台左邊的橘色按鈕，把狗狗送上來。","狗狗先拿中間平台的狗臉鑰匙，再讓開右邊電梯的按鈕。","貓咪把箱子先推到中間平台右緣，放開 2 號按鈕，等右邊電梯降到底，再繼續推上電梯。狗狗踩 2 號按鈕送貨到頂樓。","貓咪把箱子推到頂樓藍色按鈕上，打開門，但先別回家。","先讓右邊電梯下降接狗狗，再由貓咪踩頂樓橘色按鈕，等狗狗上平台。","貓咪拿頂樓的貓臉鑰匙，兩人一起進小屋。"],"legacyId":17,"saveKey":"original-17","group":"main","legacy":false},{"id":10,"cameraTop":-100,"boxes":[{"x":120,"y":358,"w":64,"h":42,"heavy":true},{"x":290,"y":358,"w":48,"h":42,"heavy":false}],"gates":[{"x":260,"y":-120,"w":28,"h":520,"buttons":[{"x":185,"y":400,"w":30}]},{"x":910,"y":-120,"w":20,"h":520,"buttons":[{"x":860,"y":80,"w":48}],"mode":1}],"lifts":[{"x":300,"w":140,"bottom":400,"top":240,"speed":90,"buttons":[{"x":40,"y":400,"w":36},{"x":500,"y":240,"w":36}]},{"x":640,"w":140,"bottom":240,"top":80,"speed":90,"buttons":[{"x":540,"y":240,"w":26},{"x":810,"y":80,"w":26}]}],"platforms":[{"x":440,"y":240,"w":200,"h":16},{"x":780,"y":80,"w":220,"h":16}],"switches":[{"x":450,"y":240,"w":36}],"name":"終極搬家計畫","hint":"地面留重箱，貨物送頂樓，別忘了月亮門。","mode":0,"starts":[4,80],"keys":[{"x":160,"y":224,"r":12},{"x":610,"y":182,"r":12,"owner":0},{"x":960,"y":22,"r":12,"owner":1}],"door":{"x":960,"y":-2,"w":40,"h":82},"solution":["先用地面重箱墊高，貓咪在下、狗狗在上疊站，拿起點上方的鑰匙。","兩人回到重箱左邊，一起推到藍色按鈕上。重箱留在地面壓門，後面只搬普通箱子。","貓咪把普通箱子推上左邊電梯，狗狗踩地面橘色按鈕送上樓。貓咪把箱子暫停在中間平台中央。","先放電梯下降接狗狗，再由貓咪踩中間平台橘色按鈕送上來。貓咪拿中間的貓臉鑰匙。","確認頂樓月亮門的月亮已亮起；若沒亮，走開再踩中間平台左端的星星。接下來不要重踩星星。","狗狗在星星附近等候。貓咪把箱子先推到中間平台右緣，放開 2 號按鈕，等右邊電梯下降再繼續推上去。狗狗再踩 2 號按鈕送貨到頂樓。","貓咪把箱子推到頂樓紫色按鈕上，打開月亮門。先放電梯下降，再踩頂樓橘色按鈕接狗狗。","狗狗拿最上面的狗臉鑰匙，等兩人都到頂樓，再一起回家。"],"legacyId":19,"saveKey":"original-19","group":"main","legacy":false},{"cameraTop":60,"boxes":[],"gates":[{"x":470,"y":-120,"w":28,"h":640,"number":1,"pads":[{"x":350,"y":400,"w":50,"owner":1,"number":1},{"x":520,"y":400,"w":50,"owner":0,"number":1}]},{"x":680,"y":-120,"w":28,"h":640,"number":2,"pads":[{"x":560,"y":400,"w":50,"owner":1,"number":2},{"x":740,"y":400,"w":50,"owner":0,"number":2}]}],"lifts":[{"x":1180,"w":160,"bottom":400,"top":200,"speed":90,"buttons":[{"x":1080,"y":400,"w":50,"owner":1,"number":3},{"x":1400,"y":200,"w":50,"owner":0,"number":3}]}],"platforms":[{"x":1340,"y":200,"w":410,"h":16}],"switches":[],"door":{"x":1660,"y":118,"w":68,"h":82},"fallY":490,"coop":"nearby-ice","mix":"ice-swap","name":"近身換跳冰塔","ice":true,"jumpSwap":true,"helpRange":230,"starts":[80,20],"floor":[{"x":0,"y":400,"w":220},{"x":300,"y":400,"w":120},{"x":510,"y":400,"w":120},{"x":720,"y":400,"w":110},{"x":900,"y":400,"w":280}],"keys":[{"x":350,"y":378,"r":12,"owner":0},{"x":1620,"y":178,"r":12,"owner":1}],"hint":"輪流過冰岸、踩機關接朋友，最後再合力搭電梯上樓。","solution":["狗狗先靠近貓咪。貓咪向右助跑時，狗狗按 ↑ 幫跳，貓咪自己提前反向減速。","貓咪往小冰岸右側讓位，換狗狗助跑；貓咪按 W 幫跳，狗狗自己提前減速。","第二、三座冰岸還要踩住貓狗臉機關開門；先過岸的貓咪接手，才能接狗狗。","兩人輪流前進，每座冰岸都要會合再走。太遠時，無法幫朋友跳，連線會變紅。","貓咪拿前段鑰匙；每座冰岸先落地站穩，再接朋友，別超過幫跳距離。兩人在最後的長冰岸會合，接著搭電梯。","最後還有 3 號電梯：貓咪先搭，狗狗踩下層機關送上去。狗狗離開機關往右等電梯降下來，再搭上去；貓咪踩上層機關接回狗狗。兩人拿齊鑰匙到小屋。"],"saveKey":"campaign-12-2","extension":{"type":"lift","x":1180,"bottom":400,"top":200,"lower":1080,"upper":1400},"world":{"width":1760,"top":-20,"bottom":500},"id":11,"group":"main"},{"cameraTop":-80,"boxes":[],"gates":[],"lifts":[{"x":260,"w":140,"bottom":400,"top":240,"speed":90,"buttons":[{"x":140,"y":400,"w":50,"owner":1,"number":1},{"x":450,"y":240,"w":50,"owner":0,"number":1}]},{"x":630,"w":150,"bottom":240,"top":80,"speed":90,"buttons":[{"x":550,"y":240,"w":50,"owner":0,"number":2},{"x":850,"y":80,"w":50,"owner":1,"number":2}]},{"x":1120,"w":160,"bottom":80,"top":-140,"speed":90,"buttons":[{"x":1020,"y":80,"w":50,"owner":1,"number":3},{"x":1340,"y":-140,"w":50,"owner":0,"number":3}]}],"platforms":[{"x":400,"y":240,"w":230,"h":16},{"x":780,"y":80,"w":340,"h":16},{"x":1280,"y":-140,"w":410,"h":16}],"switches":[],"door":{"x":1600,"y":-222,"w":68,"h":82},"fallY":490,"coop":"ice-lifts","ice":true,"jumpSwap":true,"starts":[80,20],"floor":[{"x":0,"y":400,"w":230}],"keys":[{"x":520,"y":210,"r":12,"owner":0},{"x":1560,"y":-162,"r":12,"owner":1}],"hint":"朋友幫你跳，自己反向減速；先搭上電梯，再請朋友壓機關。","solution":["貓咪先搭上降到底的左電梯，再由狗狗踩地面 1 號機關送上樓。需要起跳時，狗狗按 ↑ 幫貓咪跳。","貓咪上中間岸後，先別壓 1 號機關。狗狗離開下面的機關，等電梯降到底，再搭上去。","貓咪踩中間層的 1 號機關接狗狗，並用 W 幫狗狗跳上岸；狗狗自己用左右鍵減速。","換狗狗搭右電梯，貓咪踩中間層的 2 號機關送上頂樓。狗狗先離開頂樓機關，等貓咪放開下面的機關，讓電梯下降接人。","貓咪搭上右電梯後，狗狗踩上層 2 號機關接上來。貓咪先拿中間層的鑰匙；狗狗的鑰匙在第三層，兩人會合後繼續往右。","最後還有 3 號電梯：貓咪先搭，狗狗踩下層機關送上去。狗狗離開機關往右等電梯降下來，再搭上去；貓咪踩上層機關接回狗狗。兩人拿齊鑰匙到小屋。"],"mix":"ice-lifts","name":"冰上三層接應","saveKey":"campaign-14-2","extension":{"type":"lift","x":1120,"bottom":80,"top":-140,"lower":1020,"upper":1340},"world":{"width":1700,"top":-360,"bottom":500},"id":12,"group":"main"},{"cameraTop":20,"boxes":[],"gates":[{"x":390,"y":-120,"w":28,"h":640,"pads":[{"x":140,"y":400,"w":50,"owner":1,"number":1},{"x":450,"y":400,"w":50,"owner":0,"number":1}],"number":1,"mode":1},