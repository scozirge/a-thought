e":true,"jumpSwap":true,"phaseOnJump":true,"mode":0,"starts":[80,20],"floor":[{"x":0,"y":400,"w":220},{"x":440,"y":400,"w":160},{"x":820,"y":400,"w":180},{"x":1240,"y":400,"w":360}],"movers":[{"x":280,"y":376,"w":100,"h":16,"pads":[{"x":140,"y":400,"w":50,"owner":1,"number":1},{"x":450,"y":400,"w":50,"owner":0,"number":1}],"number":1,"mode":1,"range":24,"phase":0},{"x":660,"y":376,"w":100,"h":16,"pads":[{"x":550,"y":400,"w":50,"owner":0,"number":2},{"x":850,"y":400,"w":50,"owner":1,"number":2}],"number":2,"mode":0,"range":24,"phase":3.141592653589793},{"x":1080,"y":376,"w":100,"h":16,"mode":1,"pads":[{"x":940,"y":400,"w":50,"owner":1,"number":3},{"x":1260,"y":400,"w":50,"owner":0,"number":3}],"number":3,"range":24,"phase":1.5707963267948966}],"keys":[{"x":520,"y":378,"r":12,"owner":0},{"x":1470,"y":378,"r":12,"owner":1}],"hint":"壓機關接橋、朋友幫跳、起跳換路；冰橋不停，自己反向減速。","solution":["狗狗先踩住起點 1 號機關。等左邊月亮冰橋升到合適高度，幫助跑的貓咪按 ↑ 起跳，貓咪自己反向減速。","貓咪再請狗狗幫跳到中間固定岸，壓住 1 號機關接手。換狗狗過橋，貓咪負責 W 幫跳，狗狗自己控制滑行。","貓咪移到中間岸 2 號機關，這次狗狗先過右橋。先把世界切成月亮，再讓狗狗起跳切成太陽，右橋才會出現。","狗狗到右岸後壓住 2 號機關，換貓咪跟過來。朋友在移動冰橋上時，不能離開機關或讓另一人亂跳。","貓咪先拿中間岸的鑰匙，接回朋友後再往右挑戰第三座月亮橋。先讓橋接近地面，再安排幫跳與落點；橋不會停下來。","還有第三座月亮橋。狗狗踩右岸 3 號機關，貓咪在太陽時起跳換成月亮，過橋後踩 3 號機關接狗狗。朋友在橋上時不要亂跳；最後拿狗狗鑰匙回家。"],"mix":"final","name":"三段移動日月橋","saveKey":"campaign-18-2","extension":{"type":"bridge","moving":true},"world":{"width":1600,"top":-100,"bottom":500},"id":14,"group":"main"},{"viewHeight":480,"platforms":[{"x":1760,"y":220,"w":680,"h":16}],"gates":[{"x":400,"y":40,"w":28,"h":360,"buttons":[{"x":1340,"y":400,"w":58,"owner":1}],"openAfterKey":1},{"x":650,"y":40,"w":28,"h":360,"keyIndices":[0,1]},{"x":900,"y":40,"w":28,"h":360,"buttons":[{"x":500,"y":400,"w":58,"owner":0}],"openAfterKey":0},{"x":1940,"y":-200,"w":28,"h":420,"buttons":[{"x":1260,"y":400,"w":60,"crateOnly":true}],"openAfterKey":2},{"x":2180,"y":-200,"w":28,"h":420,"buttons":[{"x":1390,"y":400,"w":60,"crateOnly":true},{"x":2100,"y":220,"w":58,"owner":1}],"openAfterKey":3}],"boxes":[{"x":260,"w":48,"h":42,"y":358},{"x":960,"w":48,"h":42,"y":358}],"lifts":[{"x":1600,"w":160,"bottom":400,"top":220,"speed":110,"buttons":[{"x":1180,"y":400,"w":60,"crateOnly":true},{"x":1800,"y":220,"w":58,"owner":0}]}],"switches":[],"name":"雙城連動塔","hint":"移動連動箱子，替樓上的朋友開路。","starts":[80,1080],"world":{"width":2440,"top":-100,"bottom":520},"floor":[{"x":0,"y":400,"w":1720}],"linkedBoxes":[[0,1]],"keys":[{"x":120,"y":270,"r":12,"owner":0},{"x":1200,"y":270,"r":12,"owner":1},{"x":2020,"y":198,"r":12,"owner":0},{"x":2280,"y":198,"r":12,"owner":0}],"door":{"x":2340,"y":138,"w":68,"h":82},"solution":["先拿左邊的貓咪鑰匙，再把連動箱子移到右邊拿狗狗鑰匙。箱子遇到牆或人，兩個都會停。","狗狗先走到最右的狗狗按鈕，打開貓咪面前的門。","貓咪穿門踩住貓咪按鈕，打開狗狗房間中間的門。狗狗走到箱子右邊，往左推，讓左邊的箱子移到貓咪鑰匙下。","貓咪繼續踩著，等狗狗回到最右按鈕，再回左邊爬箱子拿鑰匙；狗狗房間的門會固定打開。","狗狗留在最右按鈕。貓咪把左箱往右推到門後，右箱就會移到狗狗鑰匙下。","狗狗拿到下面的鑰匙，地面的三道門打開；兩人接著利用連動箱子控制右邊升降台。","拿齊下面兩把鑰匙後，還要留著連動箱子。右箱壓不同方形座，分別控制升降台與樓上的兩道門。","狗狗先把右箱往右移開升降台的方形座，讓升降台降下。貓咪繞過箱子、搭上升降台；狗狗再把右箱推回升降台座，送貓咪上樓。","貓咪上樓先離開貓臉機關。狗狗把右箱移到下一個方形座，打開第一道樓上門，也讓升降台降回來；狗狗上台後，貓咪踩上層貓臉機關接他。","貓咪通過第一道門拿鑰匙，固定開門。狗狗回到樓下，把右箱再往右移到最後的方形座；貓咪離開上層機關，讓升降台下降接狗狗，再踩回去。","狗狗上樓踩住狗臉機關，與樓下箱子一起開最後的門。貓咪拿最後鑰匙固定開門，再一起進小屋。"],"puzzle":"linked-tower","saveKey":"campaign-linked-tower-1","id":15,"group":"main"},{"viewHeight":480,"platforms":[{"x":20,"y":350,"w":50,"h":12},{"x":246,"y":350,"w":50,"h":12},{"x":656,"y":350,"w":50,"h":12},{"x":786,"y":350,"w":50,"h":12},{"x":1336,"y":350,"w":50,"h":12},{"x":1446,"y":350,"w":50,"h":12},{"x":2060,"y":240,"w":380,"h":16},{"x":2180,"y":188,"w":80,"h":16},{"x":2600,"y":80,"w":520,"h":16}],"gates":[{"x":1560,"y":40,"w":28,"h":360,"buttons":[{"x":725,"y":400,"w":50,"crateOnly":true},{"x":1410,"y":400,"w":50,"crateOnly":true}],"openAfterKey":2},{"x":2920,"y":-200,"w":28,"h":280,"mode":1,"buttons":[{"x":2820,"y":80,"w":60,"crateOnly":true}]}],"boxes":[{"x":100,"w":48,"h":42,"y":358},{"x":210,"w":48,"h":42,"y":358}],"lifts":[{"x":1900,"w":160,"bottom":400,"top":240,"speed":110,"buttons":[{"x":1780,"y":400,"w":58,"owner":1},{"x":2100,"y":240,"w":58,"owner":0}]},{"x":2440,"w":160,"bottom":240,"top":80,"speed":110,"buttons":[{"x":2320,"y":240,"w":58,"owner":0},{"x":2640,"y":80,"w":58,"owner":1}]}],"switches":[{"x":2200,"y":188,"w":42}],"name":"渡船送貨上高塔","hint":"先送貨過河，再把同一箱送上樓。","starts":[20,170],"world":{"width":3120,"top":-180,"bottom":520},"floor":[{"x":0,"y":400,"w":290},{"x":650,"y":400,"w":190},{"x":1320,"y":400,"w":580}],"fallY":650,"rafts":[{"x":290,"y":400,"w":150,"h":18,"min":290,"max":500,"speed":140,"controls":[{"x":24,"y":350,"w":42,"dir":-1},{"x":250,"y":350,"w":36,"dir":1},{"x":660,"y":350,"w":42,"dir":-1},{"x":790,"y":350,"w":42,"dir":1}]},{"x":840,"y":400,"w":150,"h":18,"min":840,"max":1170,"speed":140,"controls":[{"x":660,"y":350,"w":42,"dir":-1},{"x":790,"y":350,"w":42,"dir":1},{"x":1340,"y":350,"w":42,"dir":-1},{"x":1450,"y":350,"w":42,"dir":1}]}],"keys":[{"x":752,"y":350,"r":12,"owner":1},{"x":1515,"y":350,"r":12,"owner":0},{"x":1640,"y":350,"r":12},{"x":2980,"y":30,"r":12,"owner":1}],"door":{"x":3020,"y":-2,"w":68,"h":82},"solution":["兩個箱子都要搭船：中間島和右岸各留一個。跳上箭頭台開船，離開箭頭台就停。","狗狗把前面的箱子推上第一艘船，貓咪踩左岸的右箭頭送他過河。","狗狗先把這個箱子一路推上第二艘船，拿自己的鑰匙，再踩中間島左箭頭，把船叫回來。","貓咪把另一個箱子推上第一艘船，狗狗換踩右箭頭接貓咪。貓咪把箱子留在中間島的方形座上。","狗狗踩左箭頭，叫回載著第一個箱子的第二艘船。貓咪跳過中間箱子上船，狗狗再踩右箭頭送她到右岸。","貓咪把箱子留在右岸方形座、拿鑰匙。用右岸左箭頭叫船接狗狗，等狗狗上船再換右箭頭。","過河後，拿門後的鑰匙固定開門。右岸的箱子還有工作，要帶它搭兩次升降台。","把右岸箱子推上第一部升降台，貓咪一起搭，狗狗踩地面狗臉機關送貨上樓。貓咪把箱子推到上層，先等升降台降下，再踩貓臉機關接狗狗。","在中層跳上星星台，把最後的門切成月亮。狗狗把箱子推上第二部升降台，貓咪在下方貓臉機關送他和箱子上頂樓。","狗狗把箱子推到頂樓方形座上，再離開頂樓機關，讓升降台降下來接貓咪。貓咪上台後，狗狗踩頂樓狗臉機關接朋友。","箱子壓住頂樓機關、世界是月亮，最後的門才開。狗狗拿最右邊鑰匙，兩人都到小屋。"],"puzzle":"ferry-tower","saveKey":"campaign-ferry-tower-1","mode":0,"cargoBox":1,"id":16,"group":"main"},{"coop":"ascent","ice":false,"jumpSwap":true,"phaseOnJump":true,"mode":0,"cameraTop":60,"starts":[80,20],"floor":[{"x":0,"y":400,"w":220},{"x":440,"y":400,"w":160},{"x":820,"y":400,"w":800}],"platforms":[{"x":1070,"y":344,"w":90,"h":16},{"x":1150,"y":288,"w":90,"h":16},{"x":1210,"y":240,"w":50,"h":16},{"x":1640,"y":240,"w":300,"h":16},{"x":2080,"y":-40,"w":280,"h":16},{"x":2500,"y":-320,"w":160,"h"